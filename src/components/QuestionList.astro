---
import type { Question } from '../lib/questions';
import { examStages, subjects, topics } from '../lib/taxonomy';
interface Props {
  questions: Question[];
  emptyMessage?: string;
  headingLevel?: 2 | 3 | 4;
}
const {
  questions,
  emptyMessage = '公開済みの問題はまだありません。',
  headingLevel = 2,
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

{questions.length ? (
  <ol class="question-list">
    {questions.map((question) => (
      <li
        class="question-entry"
        data-year={question.data.year}
        data-subject={question.data.subject}
      >
        <p class="entry-meta">
          <span>{question.data.year}年度</span>
          <span>
            {examStages[question.data.examStage].label}{' '}
            {subjects[question.data.subject].label}
          </span>
          <span>
            問{question.data.questionNumber}
            {question.data.partNumber && ' (' + question.data.partNumber + ')'}
          </span>
        </p>
        <Heading>
          <a href={'/questions/' + question.id + '/'}>{question.data.title}</a>
        </Heading>
        <ul class="topic-links">
          {question.data.topics.map((topic) => (
            <li>
              <a href={'/topics/' + topic + '/'}>{topics[topic].label}</a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
) : (
  <p class="empty-state">{emptyMessage}</p>
)}
