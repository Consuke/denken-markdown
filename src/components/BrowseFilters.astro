---
import { getVisibleQuestions } from '../lib/questions';
import {
  examStages,
  examStageSlugs,
  subjects,
  topics,
  subjectSlugs,
  topicSlugs,
} from '../lib/taxonomy';
interface Props {
  headingLevel?: 2 | 3;
}
const Heading = Astro.props.headingLevel === 3 ? 'h3' : 'h2';
const all = await getVisibleQuestions();
// 表示対象の問題がある科目・分野だけを並べる（ページも同じ条件で出力）。
const usedSubjects = new Set(all.map((question) => question.data.subject));
const usedTopics = new Set(all.flatMap((question) => question.data.topics));
const subjectGroups = examStageSlugs
  .map((stage) => ({
    stage,
    items: subjectSlugs.filter(
      (subject) =>
        subjects[subject].stage === stage && usedSubjects.has(subject),
    ),
  }))
  .filter((group) => group.items.length > 0);
const years = [...new Set(all.map((question) => question.data.year))].sort(
  (a, b) => b - a,
);
---

<nav class="browse-filters" aria-label="問題の分類から探す">
  <section>
    <Heading>科目別</Heading>
    {subjectGroups.map((group) => (
      <ul aria-label={examStages[group.stage].label}>
        {subjectGroups.length > 1 && (
          <li class="stage-label">{examStages[group.stage].label}</li>
        )}
        {group.items.map((subject) => (
          <li>
            <a href={'/subjects/' + subject + '/'}>{subjects[subject].label}</a>
          </li>
        ))}
      </ul>
    ))}
  </section>
  {years.length > 0 && (
    <section>
      <Heading>年度別</Heading>
      <ul>
        {years.map((year) => (
          <li>
            <a href={'/years/' + year + '/'}>{year}年度</a>
          </li>
        ))}
      </ul>
    </section>
  )}
  <section>
    <Heading>分野別</Heading>
    <ul>
      {topicSlugs
        .filter((topic) => usedTopics.has(topic))
        .map((topic) => (
          <li>
            <a href={'/topics/' + topic + '/'}>{topics[topic].label}</a>
          </li>
        ))}
    </ul>
  </section>
</nav>
