---
interface Props {
  section: 'question' | 'answer' | 'prompt';
  label: string;
}
const { section, label } = Astro.props;
---

<button
  type="button"
  class="copy-button markdown-copy"
  data-copy-key={section}
  hidden
>
  {label}
</button>

<script>
  import { installCopyControls } from '../lib/copy';
  installCopyControls();
</script>
