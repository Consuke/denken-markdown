---
import QuestionIndex from '../../components/QuestionIndex.astro';
import { getVisibleQuestions, type Question } from '../../lib/questions';
import {
  examStages,
  subjects,
  subjectSlugs,
  type Subject,
} from '../../lib/taxonomy';
export async function getStaticPaths() {
  const all = await getVisibleQuestions();
  // 表示対象の問題がない科目（下書きだけの科目など）はページを出さない。
  return subjectSlugs
    .map((subject) => ({
      params: { subject },
      props: {
        subject,
        questions: all.filter((entry) => entry.data.subject === subject),
      },
    }))
    .filter(({ props }) => props.questions.length > 0);
}
interface Props {
  subject: Subject;
  questions: Question[];
}
const { subject, questions } = Astro.props;
const stage = examStages[subjects[subject].stage].label;
const title = `${stage}「${subjects[subject].label}」の問題`;
---

<QuestionIndex
  title={title}
  description={subjects[subject].description}
  questions={questions}
  groupBy={['year']}
  jumpLinks
  breadcrumbs={[
    { label: '問題一覧', href: '/questions/' },
    { label: `${stage} ${subjects[subject].label}` },
  ]}
/>
