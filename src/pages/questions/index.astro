---
import QuestionIndex from '../../components/QuestionIndex.astro';
import { getVisibleQuestions } from '../../lib/questions';
const questions = await getVisibleQuestions();
---

<QuestionIndex
  title="問題一覧"
  description="電験二種（一次試験・二次試験）の問題一覧。年度・科目・分野別に問題と公式解答を掲載しています。"
  questions={questions}
  breadcrumbs={[{ label: '問題一覧' }]}
/>
