---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { isContentPreview } from '../lib/questions';
import { siteName, defaultDescription } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = defaultDescription,
  noindex = false,
} = Astro.props;
const canonicalPath = ['/404', '/404/', '/404.html'].includes(
  Astro.url.pathname,
)
  ? '/404.html'
  : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = new URL(canonicalPath, Astro.site);
const pageTitle = `${title} | ${siteName}`;
const preventIndexing =
  noindex || isContentPreview || Astro.site?.hostname === 'example.com';
---

<!doctype html>
<html lang="ja" data-content-preview={isContentPreview ? 'true' : 'false'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    {preventIndexing && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="電験二種 過去問・解説" />
    <meta name="twitter:card" content="summary_large_image" />
    {!preventIndexing && (
      <script
        is:inline
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5293965345695237"
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <Header />
    <main id="main" class="shell" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
